# Copy to .env (run.sh does this automatically). Test-only values for the local docker environment.

# nacos/nacos-server image tag: v2.5.4 or v3.2.4
NACOS_VERSION=v3.2.4
# Spring Cloud train used to build the Eureka Server image (see sc_versions in run.sh for the supported ones)
SC_TRAIN=2024.0

NACOS_USERNAME=nacos
NACOS_PASSWORD=e2e-test-only-pass
# Base64 of a 32+ character test string
NACOS_AUTH_TOKEN=ZTJlLXRlc3Qtb25seS10b2tlbi1mb3ItbmFjb3Mtc3luYy1lMmUtc3VpdGU=

MYSQL_ROOT_PASSWORD=e2e-test-only-mysql
